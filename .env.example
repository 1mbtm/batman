# Required Cloudflare Pages Secrets (for local development with `npx wrangler pages dev`, copy to `.dev.vars`)
# NOTE: Admin authentication is disabled (fails closed with 503) if ADMIN_PASSWORD or ADMIN_TOKEN_SECRET is unset.
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
CRON_SECRET=
ANALYTICS_RETENTION_DAYS=90
ALLOWED_ORIGIN=https://batman-7y3.pages.dev
