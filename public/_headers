# Cloudflare Pages _headers Configuration
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Root and all HTML routes — security headers & content negotiation caching
/*
  Vary: Accept, Accept-Encoding
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Admin routes — strictly excluded from search indexing and caching
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Markdown agent index (acceptmarkdown.com standard)
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept, Accept-Encoding
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# 404 page body — raw markdown for AI agent recovery
/404.html
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept, Accept-Encoding
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

# OpenAPI 3.1 Specification with CORS and Vary
/openapi.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  Vary: Accept, Accept-Encoding
  Cache-Control: public, max-age=86400

# Dynamic Visitor Analytics & Admin Endpoints — Restricted CORS & Never Cache
/api/analytics/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: https://batman-7y3.pages.dev
  Access-Control-Allow-Methods: GET, POST, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Visitor-Token
  Access-Control-Allow-Credentials: true
  Vary: Origin
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-store, no-cache, must-revalidate

# Versioned Public REST API Endpoints — Rate Limiting & Caching
/api/v1/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS
  RateLimit-Limit: 100
  RateLimit-Remaining: 99
  RateLimit-Reset: 60
  Vary: Accept, Accept-Encoding
  Cache-Control: public, max-age=600

# XML Sitemap
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Vary: Accept, Accept-Encoding
  Cache-Control: public, max-age=86400

# robots.txt
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
